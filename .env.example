# GitHub OAuth Configuration
# Get these values from your GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GitHub App Configuration (for repository integration)
# Get these values from your GitHub App
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your_github_app_private_key_here
-----END RSA PRIVATE KEY-----"

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zeitwork

# Application URLs
APP_URL=http://localhost:3000
GRAPH_ENDPOINT=http://localhost:8080/graph

# Session Security
SESSION_PASSWORD=change-this-to-a-secure-32-character-minimum-password

# Development Settings
NODE_ENV=development